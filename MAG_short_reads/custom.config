#custom.config
params {
    gtdb_db = "/projects/zvbd_lab/Beatriz/MAG_scripts_short_reads/databases/gtdb_r226/release226"
}

process {
    withName: '.*:METASPADES' {
        memory = 380.GB
        cpus = 40
        time = '72.h'
    }
}

process {
    withName: 'NFCORE_MAG:MAG:CATPACK:CATPACK_SUMMARISE_BINS' {
        errorStrategy = 'ignore'
    }
}
